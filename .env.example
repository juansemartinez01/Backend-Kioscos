# Copiar a .env.local y completar. NUNCA commitear el .env real.
#
# Ojo: en el proyecto viejo, .env.production estaba versionado (excepción
# `!.env.production` en el .gitignore) y definía DB_PASSWORD mientras el código
# leía DB_PASS, así que ni siquiera se usaba. Acá solo se versiona este ejemplo.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kioscos_multitenant
DB_USER=
DB_PASS=
DB_SSL=false

# Cada request en vuelo retiene una conexión mientras dura su transacción.
DB_POOL_MAX=10

# En false por defecto. Ponerlo en true solo en el arranque del contenedor.
DB_MIGRATIONS_RUN=false

# Sin esto el proceso no arranca: no hay valor por defecto, a propósito.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Separados por coma. Vacío = CORS cerrado.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
